# Example env for Strategy Bot
APP_MODE=PAPER
ALLOWED_DIRECTIONS=BUY,SELL
SCORE_THRESHOLD=0.60
INPUT_FINBOX=data/finbox_notifications.json
INPUT_ZALO=data/zalo_script.txt
ACCOUNT_FILE=data/account.json
OUTPUT_DIR=outputs
# Authentication
AUTH_ENABLED=true
AUTH_USER=admin
AUTH_PASS=changeme
# Scheduler times
ENTRY_WINDOW_START=09:00
ENTRY_WINDOW_END=15:00
CLOSE_TIME=14:30
